# System unit: runs Hopsync as the dedicated unprivileged user "hopsync".
# Install: useradd --system --create-home --home-dir /var/lib/hopsync hopsync
#          install -m 0755 hopsync /usr/local/bin/hopsync
#          cp hopsync.service /etc/systemd/system/ && systemctl enable --now hopsync
# On first start, read the one-time setup token: sudo cat /var/lib/hopsync/data/setup-token
# Transfers can only read and write below /srv/hopsync (the --root); change both lines together.

[Unit]
Description=Hopsync file transfer service
Documentation=https://github.com/YourNeelsOG/hopsync
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hopsync
Group=hopsync
ExecStart=/usr/local/bin/hopsync serve --listen 127.0.0.1:7890 --data-dir /var/lib/hopsync/data --root /srv/hopsync --socket /run/hopsync/hopsync.sock
Restart=on-failure
RestartSec=5s
# A job interrupted by a stop resumes from its journal on the next start.
TimeoutStopSec=30s

StateDirectory=hopsync
StateDirectoryMode=0700
RuntimeDirectory=hopsync
RuntimeDirectoryMode=0700
ReadWritePaths=/srv/hopsync
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
